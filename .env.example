QUOLLNET_SERVICE=quollnet-mcp
QUOLLNET_VERSION=0.1.0
QAUTH_ISSUER_URL=https://quollnet.com/api
QAUTH_TIMEOUT_SECONDS=15
MCP_RESOURCE_URI=https://mcp.quollnet.com/mcp
CASHFLOWPOT_MCP_RESOURCE_URI=https://mcp.quollnet.com/cashflowpot
QAPP_BASE_URL=https://quollnet.com
QAPP_TIMEOUT_SECONDS=15
QFLOW_BASE_URL=https://cashflowpot.com/api/
QFLOW_TIMEOUT_SECONDS=30
QAUTH_APP_ID=your-qauth-main-app-id
QAUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-qauth-main-public-key\n-----END PUBLIC KEY-----"
QAPP_APP_ID=your-qapp-qauth-app-id
CASHFLOWPOT_APP_ID=your-cashflowpot-qauth-app-id

# Optional dedicated QLedger endpoint (combined_app:app).
QLEDGER_ENABLED=false
QLEDGER_APP_ID=
QLEDGER_BASE_URL=
QLEDGER_MCP_RESOURCE_URI=https://mcp.quollnet.com/qledger
QLEDGER_TIMEOUT_SECONDS=30
QLEDGER_MAX_FILE_BYTES=10485760
QLEDGER_MAX_BATCH_FILE_BYTES=20971520
